float radius = lerp(RingInnerRadius,RingOuterRadius,saturate(UV.x));
float azimuth = UV.y*6.28318530718;
float3 p = float3(radius*cos(azimuth),radius*sin(azimuth),0.0);
float3 sun = sm.SafeNormal(SunDirectionLocal);
float3 view = sm.SafeNormal(CameraLocal-p);
float mu0 = max(abs(sun.z),0.002), mu = max(abs(view.z),0.002);
float4 profile = Texture2DSample(RingTex,RingTexSampler,float2(saturate(UV.x),0.5));
float tau = sm.OpticalDepth(profile.a,RingOpacityScale);
float alpha = 1.0-exp(-min(tau/mu,80.0));
float visibility = sm.EllipsoidSunVisibility(p,sun,BodyAxes,SunAngularRadius)
                 * sm.SphereSunVisibility(p,sun,OccluderLocal,OccluderRadius,SunAngularRadius);
float opticalSlab;
if (sun.z*view.z>=0.0)
{
    opticalSlab = mu0/(mu0+mu)*(1.0-exp(-min(tau*(1.0/mu0+1.0/mu),80.0)));
}
else
{
    // Opposite-side slab integral, factored to avoid subtracting nearly equal
    // exponentials as the moving camera crosses equal illumination/view angles.
    // x is optical-depth difference (not reciprocal-angle difference).
    float viewDepth = tau/mu, sunDepth = tau/mu0;
    float x = abs(viewDepth-sunDepth);
    float integral = (x<0.001) ? (1.0-x*0.5+x*x/6.0)
                             : (1.0-exp(-min(x,80.0)))/max(x,1e-8);
    opticalSlab = viewDepth*exp(-min(min(viewDepth,sunDepth),80.0))*integral;
}
// Backscatter toward Sun/view coincidence, never world-camera-fixed highlights.
float phaseCos = clamp(dot(sun,view),-1.0,1.0);
float g = clamp(RingBackscatter,0.0,0.65);
float phase = (1.0-g*g)/pow(max(1.0+g*g-2.0*g*phaseCos,0.03),1.5);
float3 radiance = max(profile.rgb,0.0)*saturate(RingAlbedo)*phase*0.25
                *max(opticalSlab,0.0)*max(SunRadiance,0.0)*visibility;
return float4(radiance/max(alpha,1e-5),saturate(alpha));
